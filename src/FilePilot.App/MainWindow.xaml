<Window x:Class="FilePilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FilePilot" Width="540" Height="460" MinWidth="460" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
    <Window.InputBindings>
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyPathCommand}" />
    </Window.InputBindings>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Content="_Dark theme" Click="ToggleTheme" AutomationProperties.Name="Toggle light or dark theme" />
            <StackPanel>
                <TextBlock Text="FilePilot" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="A little less file work." Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="{Binding FileName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                <TextBox Text="{Binding FullPath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto"
                         Margin="0,8,0,10" AutomationProperties.Name="Selected file path" />
                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <UniformGrid Grid.Row="2" Columns="2" Margin="0,16,0,0">
            <Button Content="_Copy Path" Command="{Binding CopyPathCommand}" Margin="0,0,6,0" ToolTip="Copy absolute path (Ctrl+Shift+C)" />
            <Button Content="_Move File…" Click="MoveFile" IsEnabled="{Binding CanMove}" Margin="6,0,0,0" />
        </UniformGrid>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{Binding Status}" Margin="0,16,0,8" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" /></ScrollViewer>
        <DockPanel Grid.Row="4"><Button DockPanel.Dock="Right" Content="C_hoose file…" Click="ChooseFile" IsEnabled="{Binding CanChooseFile}" /><TextBlock Text="LOCAL FILE ACTIONS" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" /></DockPanel>
    </Grid>
</Window>


