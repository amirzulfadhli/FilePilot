<Window x:Class="FilePilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FilePilot" Width="480" Height="{Binding WindowHeight}" MinWidth="200" MinHeight="120" WindowStyle="None" ResizeMode="NoResize" PreviewKeyDown="PopupKeyDown"
        WindowStartupLocation="Manual" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="12" ResizeBorderThickness="0" GlassFrameThickness="0" /></WindowChrome.WindowChrome>
    <Window.Resources><BooleanToVisibilityConverter x:Key="BooleanVisibility" /></Window.Resources>
    <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Open" Executed="OpenFilesCommand" CanExecute="CanOpenFilesCommand" /><CommandBinding Command="ApplicationCommands.Help" Executed="OpenHelp" CanExecute="CanOpenHelp" /></Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="ApplicationCommands.Help" />
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyPathCommand}" />
    </Window.InputBindings>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10" MouseLeftButtonDown="DragHeader">
            <Button x:Name="DismissButton" DockPanel.Dock="Right" Content="×" Click="DismissPopup" AutomationProperties.Name="Close popup" ToolTip="Close (Escape)" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="⚙" Click="OpenSettings" AutomationProperties.Name="Settings" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" x:Name="ThemeButton" Content="_Dark" Click="ToggleTheme" AutomationProperties.Name="Toggle light or dark theme" />
            <StackPanel>
                <TextBlock Text="FilePilot" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Quick actions · local files" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding SelectionSummary}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionPaths}" />
                <TextBox Text="{Binding SelectionPaths, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="40" MinHeight="0" Padding="0" FontSize="12" VerticalScrollBarVisibility="Auto"
                         Margin="0,6,0,6" AutomationProperties.Name="Selected file path" />
                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <UniformGrid Columns="2" Margin="0,16,0,0">
            <Button x:Name="CopyPathButton" Content="_Copy Path" Command="{Binding CopyPathCommand}" Margin="0,0,6,0" ToolTip="Copy absolute path (Ctrl+Shift+C)" />
            <Button Content="_Move File…" Click="MoveFile" IsEnabled="{Binding CanMove}" Margin="6,0,0,0" />
        </UniformGrid>
        <Expander x:Name="RenameExpander" Header="Quick rename" Margin="0,10,0,0" IsEnabled="{Binding CanMove}">
            <StackPanel Margin="0,6,0,0">
                <DockPanel><Button DockPanel.Dock="Right" Content="_Rename" Click="RenameFile" Margin="6,0,0,0" /><TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New filename" /></DockPanel>
                <CheckBox Content="Change extension explicitly" IsChecked="{Binding ChangeExtension}" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" />
            </StackPanel>
        </Expander>
        <Expander Header="Favorite folders" Margin="0,8,0,0" IsEnabled="{Binding CanChooseFile}">
            <StackPanel Margin="0,6,0,0">
                <ComboBox x:Name="Favorites" AutomationProperties.Name="Favorite folder" />
                <UniformGrid Columns="2" Margin="0,6,0,0"><Button Content="Use for output" Click="FavoriteOutput" Margin="0,0,3,0" /><Button Content="Move here…" Click="FavoriteMove" IsEnabled="{Binding CanMove}" Margin="3,0,0,0" /></UniformGrid>
                <TextBlock Text="Add or remove favorites in Settings." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Expander>
        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsImageSelected, Converter={StaticResource BooleanVisibility}}">
            <TextBlock Text="CONVERT IMAGES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
            <Grid Margin="0,6,0,8" IsEnabled="{Binding CanChooseFile}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <Label Content="Output _format" Target="{Binding ElementName=OutputFormat}" />
                    <ComboBox x:Name="OutputFormat" ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding SelectedOutputFormat}" AutomationProperties.Name="Output format" />
                </StackPanel>
                <StackPanel Grid.Column="1" Visibility="{Binding IsJpegOutput, Converter={StaticResource BooleanVisibility}}">
                    <Label Content="JPEG _background" Target="{Binding ElementName=BackgroundColor}" />
                    <TextBox x:Name="BackgroundColor" Text="{Binding JpegBackground, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" ToolTip="Opaque background as #RRGGBB; default #FFFFFF (white)" AutomationProperties.Name="JPEG background color" />
                </StackPanel>
            </Grid>
            <DockPanel IsEnabled="{Binding CanChooseFile}" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="_Destination…" Click="ChooseDestination" Margin="8,0,0,0" />
                <TextBox Text="{Binding DestinationFolder, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" AutomationProperties.Name="Output folder" ToolTip="{Binding DestinationFolder}" />
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Content="Con_vert" Click="ConvertImage" IsEnabled="{Binding CanConvert}" />
                <Button x:Name="CancelImageButton" Grid.Column="1" Content="C_ancel" Click="CancelConversion" IsEnabled="{Binding CanCancelConversion}" Margin="8,0,0,0" />
                <Button Grid.Column="2" Content="_Open folder" Click="OpenOutputFolder" IsEnabled="{Binding CanOpenOutputFolder}" Margin="8,0,0,0" ToolTip="{Binding LastOutputPath}" />
            </Grid>
            <ProgressBar Height="3" Margin="0,8,0,0" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" AutomationProperties.Name="File operation in progress" />
        </StackPanel>
        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsDocumentSelected, Converter={StaticResource BooleanVisibility}}">
            <TextBlock Text="DOCX → PDF · PREVIEW" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DocumentEngineStatus}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,8" Foreground="{DynamicResource MutedBrush}" />
            <DockPanel IsEnabled="{Binding CanChooseFile}" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Output folder…" Click="ChooseDestination" Margin="8,0,0,0" />
                <TextBox Text="{Binding DestinationFolder, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="PDF output folder" ToolTip="{Binding DestinationFolder}" />
            </DockPanel>
            <UniformGrid Columns="3">
                <Button Content="Export _PDF" Click="ConvertDocument" IsEnabled="{Binding CanConvertDocument}" Margin="0,0,4,0" />
                <Button x:Name="CancelDocumentButton" Content="C_ancel export" Click="CancelConversion" IsEnabled="{Binding CanCancelConversion}" Margin="2,0,2,0" ToolTip="Cancel document export (Alt+A)" />
                <Button Content="_Open PDF folder" Click="OpenOutputFolder" IsEnabled="{Binding CanOpenOutputFolder}" Margin="4,0,0,0" ToolTip="Open PDF folder (Alt+O)" />
            </UniformGrid>
            <ProgressBar Height="3" Margin="0,8,0,0" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" AutomationProperties.Name="Document export in progress" />
            <TextBlock Text="Single DOCX only. External links, macros and embedded objects are refused in this first version." TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
        <Expander Header="Batch details" Visibility="{Binding IsBatch, Converter={StaticResource BooleanVisibility}}" Margin="0,8,0,0"><TextBox Text="{Binding BatchDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Batch results" /></Expander>
        </StackPanel></ScrollViewer>
        <ScrollViewer Grid.Row="2" MinHeight="58" MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="StatusText" Text="{Binding Status, NotifyOnTargetUpdated=True}" TargetUpdated="StatusTextUpdated" Margin="0,16,0,8" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" /></ScrollViewer>
        <StackPanel Grid.Row="3"><TextBlock x:Name="ShortcutHint" Text="ESC TO DISMISS" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" /><DockPanel><Button DockPanel.Dock="Right" Content="E_xit" Click="ExitApplication" Padding="10,8" Margin="6,0,0,0" ToolTip="Stop FilePilot and release its shortcut" /><Button x:Name="HelpButton" DockPanel.Dock="Right" Content="?" Command="ApplicationCommands.Help" IsEnabled="{Binding CanChooseFile}" AutomationProperties.Name="Help and keyboard shortcuts" ToolTip="Help (F1)" Padding="10,8" Margin="6,0,0,0" /><Button x:Name="ChooseFilesButton" Content="C_hoose files…" ToolTip="Choose one or more files (Ctrl+O)" Click="ChooseFile" IsEnabled="{Binding CanChooseFile}" /></DockPanel></StackPanel>
    </Grid></Border></Window>
